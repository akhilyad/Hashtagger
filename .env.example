# =============================================================================
# Hashtagger environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values there.
# `.env.local` (and every other .env* file except this one) is gitignored, so
# real secrets never get committed. This file must contain ONLY dummy
# placeholders.
#
#   cp .env.example .env.local
# =============================================================================

# --- AI ----------------------------------------------------------------------
# Server-only. Google Gemini API key used by /api/analyze.
GEMINI_API_KEY="your-gemini-api-key"

# --- App URL -----------------------------------------------------------------
# Canonical absolute origin of the deployed app (http/https, no trailing
# slash). Used to build Stripe success/cancel redirect URLs. REQUIRED in
# production; in development the request's own origin is used if unset.
# The browser's Origin header is never trusted for this.
APP_URL="http://localhost:3000"

# --- Stripe (server-only secrets) -------------------------------------------
# Secret key from https://dashboard.stripe.com/apikeys (sk_test_... or
# sk_live_..., or a restricted rk_... key). Placeholder values are ignored.
# Without a valid key: development runs demo checkout, production returns
# "Payments are not configured yet." and grants nothing.
STRIPE_SECRET_KEY="sk_test_replace_me"

# Signing secret of the webhook endpoint POST /api/stripe/webhook
# (Dashboard > Developers > Webhooks, or the value printed by
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`).
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# "true" forces demo checkout on the server even when a key is set: no real
# charge, invoices are marked "Demo". Leave "false" for real payments.
STRIPE_DEMO_MODE="false"

# Optional: use pre-created Stripe Prices instead of inline price_data.
# Each should be a recurring, MULTI-CURRENCY Price (with currency options for
# EUR, USD, GBP, CAD, AUD, JPY, CHF, INR) so the currency the customer picked
# can be charged. Leave empty to use the app's built-in prices.
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_AGENCY_MONTHLY=""
STRIPE_PRICE_AGENCY_ANNUAL=""

# --- Client flags (public, inlined at build time) ---------------------------
# "true" makes the UI run a clearly labelled demo checkout without calling
# the API (used for the GitHub Pages static export, which has no API routes).
NEXT_PUBLIC_PAYMENTS_DEMO="false"

# --- Build ------------------------------------------------------------------
# "true" builds a self-contained `standalone` server bundle (Docker/Cloud Run).
NEXT_STANDALONE="false"
